      "kind": "local",
      "path": "KinetixKit",
    },
  ],
  "files": [
    { "kind": "folder", "path": "Kinetix", "target-membership": [ "Kinetix" ] },
    { "kind": "folder", "path": "KinetixTests", "target-membership": [ "KinetixTests" ] },
    { "kind": "folder", "path": "KinetixUITests", "target-membership": [ "KinetixUITests" ] },
    {
      "kind": "group",
      "path": "Configuration",
      "children": [
        { "path": "App.xcconfig" },
        { "path": "Info.plist" },
        { "path": "Local.xcconfig.example" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Kinetix.app", "id": "BFBC4B7230AF304E0099472F", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/KinetixTests.xctest", "id": "BFBC4B8130AF30500099472F", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/KinetixUITests.xctest", "id": "BFBC4B8B30AF30500099472F", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Kinetix",
      "id": "BFBC4B7130AF304E0099472F",
      "product": "Products/Kinetix.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "KinetixKit",
          "product-name": "KinetixData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KinetixKit",
          "product-name": "KinetixDomain",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KinetixKit",
          "product-name": "KinetixPresentation",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Configuration/Info.plist",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.kinetix.shop",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
      },
    }, {
      "name": "KinetixTests",
      "id": "BFBC4B8030AF30500099472F",
      "product": "Products/KinetixTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Kinetix",
      "dependencies": [
        "Kinetix",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "KinetixKit",
          "product-name": "KinetixData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KinetixKit",
          "product-name": "KinetixDomain",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KinetixKit",
          "product-name": "KinetixPresentation",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.kinetix.shop.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Kinetix.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Kinetix",
      },
    }, {
      "name": "KinetixUITests",
      "id": "BFBC4B8A30AF30500099472F",
      "product": "Products/KinetixUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "Kinetix",
      "dependencies": [
        "Kinetix",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.kinetix.shop.uitests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TEST_TARGET_NAME": "Kinetix",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
